        },
        "two": {
          "uri": "https://two.svc:8443", "authenticated": false,
          "ca_certificate": "target/test-classes/cert02.pem"
        }
      },
      "app-with-hyphens": {
        "service-with-hyphens": { "uri": "http://plain.svc:8000", "authenticated": false }
      }
    }
  },
  "privateDependencyEndpoints": {
    "v2": {
      "export-service": {
        "service": { "uri": "https://export.remote.example:443", "authenticated": true }
      }
    }
  }
}
