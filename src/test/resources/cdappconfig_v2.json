{
  "tlsCAPath": "target/test-classes/cert01.pem",
  "endpoints": [
    { "app": "rbac", "name": "service", "hostname": "rbac.svc", "tlsPort": 8443 },
    { "app": "legacy", "name": "service", "hostname": "legacy.svc", "port": 8000 }
  ],
  "privateEndpoints": [
    { "app": "export-service", "name": "service", "hostname": "export.svc", "port": 10000 }
  ],
  "dependencyEndpoints": {
    "v2": {
